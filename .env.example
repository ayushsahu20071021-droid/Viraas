# Google Analytics 4 — replace with your real GA4 measurement ID
VITE_GA_ID=

# Meta Pixel — replace with your Meta Pixel ID
VITE_META_PIXEL_ID=

# AI Try-On mode: "demo" or "production"
# In demo mode, the Try-On shows the product image as a placeholder result.
# In production mode, connect your actual AI provider in netlify/functions/try-on.js
TRYON_MODE=demo

# AI Provider secrets — KEEP SERVER-SIDE ONLY (never use VITE_ prefix for secrets)
# AI_PROVIDER_API_KEY=
# AI_PROVIDER_ENDPOINT=
